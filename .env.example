# Copy this file to .env and fill it in there. THIS file is tracked by git —
# anything written here is published to the repository on the next push, and
# stays in the history afterwards. Only .env is ignored.
#
# `npm run setup` writes .env for you, so you need not edit either by hand.

# Copy to .env and fill in. The first three are required; the service refuses to
# start without them, naming the one that is missing.

# ---- Database ----
# Any Postgres 13+. The bot owns this database and creates its own schema on
# startup; nothing else should share it.
#   postgres://user:pass@host:5432/fast_fayda
# Add ?sslmode=disable for a local database without TLS.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Optional: max pooled connections (default 10).
# PGPOOL_MAX=10

# ---- Telegram ----
# From @BotFather: /newbot, then copy the token.
TELEGRAM_BOT_TOKEN=

# Shared secret Telegram echoes back on every delivery. Without it the webhook
# would accept forged updates from anyone who guesses the URL, so the service
# refuses to start rather than run open. It must be the SAME value passed to
# setWebhook -- generate one with:
#   npm run webhook secret
TELEGRAM_WEBHOOK_SECRET=

# How updates arrive: webhook (default) or polling.
#
# polling needs no public URL and no hosting at all — the bot asks Telegram for
# updates over an outbound connection, so it runs on a laptop or anywhere with
# internet. Use it to develop, and to run the bot before paying for anywhere to
# put it. Only one process may poll a bot at a time.
#
# webhook is the mode that scales, and needs TELEGRAM_WEBHOOK_SECRET above.
# BOT_MODE=polling

# Where the webhook is mounted, and the port to listen on. Change the path and
# you must re-register the webhook with the new URL.
# WEBHOOK_PATH=/webhook
# PORT=8080

# Chat that support messages are forwarded to -- a group with the bot in it, or
# your own chat. Group IDs are negative. Leave blank and messages are still
# stored in bot_support_messages, just not delivered anywhere.
# BOT_SUPPORT_CHAT_ID=

# ---- Points and payments ----
# What one print costs, in birr. A payment buys floor(amount / price) points.
# POINT_PRICE_ETB=15

# Telegram IDs allowed to approve or reject a payment the bot could not confirm.
# Comma-separated. These people can create points, so keep the list short.
# ADMIN_TELEGRAM_IDS=

# Who the bot tells people to contact when it cannot help them.
# ADMIN_CONTACT=@your_admin_username

# Points one upload (Fayda Screenshot / Upload PDF) costs. Default 1.
# POINTS_PER_PRINT=1

# Receiving accounts shown in Buy Points. Not secret -- these are meant to be
# shown to customers. Leave blank and set them from the admin portal instead;
# whichever is set there takes priority over these.
# CBE_ACCOUNT_NAME=
# CBE_ACCOUNT_NUMBER=
# TELEBIRR_ACCOUNT_NAME=
# TELEBIRR_ACCOUNT_NUMBER=

# ---- Admin portal ----
# Signs the portal's session cookie. Leave blank and one is derived from
# ID_HASH_SECRET / DATABASE_URL, same as below. At least 32 characters if set:
#   openssl rand -base64 48
# Setting it (or changing it) signs everyone out at once.
# ADMIN_SESSION_SECRET=

# ---- Card retrieval (FAN -> OTP -> PDF) ----
# Key for the card API. Leave blank and the OTP buttons say retrieval is not
# connected, which is the truth, rather than failing halfway through.
#
# SERVER-SIDE ONLY. It spends real money -- each successful verify deducts a
# point from the account it belongs to -- so it must never reach a mini-app,
# a browser, or anything else a customer can read.
# CARD_API_KEY=
# CARD_API_URL=https://otp.affiliate.pro.et/api/v1

# How long to wait on a verify. The provider documents 60-120 seconds. Must
# stay under the platform's function timeout: a call killed mid-flight may
# already have spent a point upstream. Vercel Hobby caps at 60s.
# CARD_API_TIMEOUT_MS=55000

# ---- Status lookups ----
# Where a status check gets its answer. Leave unset and the bot tells people the
# check is unavailable, which is the truth -- it will not invent a status.
#   http = call FAYDA_API_URL (needs credentials from whoever runs the registry)
#   stub = deterministic fake answers for local development; refuses to run when
#          NODE_ENV=production, because a made-up status about someone's
#          national ID is worse than an outage
# FAYDA_PROVIDER=
# FAYDA_API_URL=
# FAYDA_API_KEY=

# ---- Hashing ----
# Keys the HMAC that stands in for an ID number in the audit log. Leave blank
# and a stable one is derived from DATABASE_URL. At least 32 characters:
#   openssl rand -base64 48
# ID_HASH_SECRET=
