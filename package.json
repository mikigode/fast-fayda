{
  "name": "fast-fayda",
  "version": "0.1.0",
  "private": true,
  "description": "A Telegram bot for Fayda application status, in Amharic and English.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "TEST_DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://postgres@127.0.0.1:5432/fast_fayda_test}\" vitest run",
    "webhook": "node scripts/bot-webhook.mjs",
    "migrate": "node dist/migrate-cli.js",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^3.0.0",
    "@napi-rs/canvas": "^1.0.11",
    "@supabase/server": "^1.4.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.20.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
