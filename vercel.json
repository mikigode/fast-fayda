{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["assets/**"]
      }
    }
  ],
  "routes": [
    { "src": "/", "dest": "/api/health" },
    { "src": "/health", "dest": "/api/health" },
    { "src": "/webhook", "dest": "/api/webhook" },
    { "src": "/admin", "dest": "/api/admin" },
    { "src": "/admin/.*", "dest": "/api/admin" },
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ]
}
