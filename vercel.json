{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "builds": [
    {
      "src": "api/*.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["assets/**"]
      }
    }
  ],

  "rewrites": [
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/:path*", "destination": "/api/admin" }
  ]
}
